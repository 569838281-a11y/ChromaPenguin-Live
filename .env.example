# Supabase project settings (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 咕咕助手自由对话（DeepSeek Chat API）
# 在 https://platform.deepseek.com 创建 API Key，填入后重启 Vite
VITE_DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY

# Optional: override magic backend when not using Vite proxy
# VITE_API_BASE=http://127.0.0.1:8765
